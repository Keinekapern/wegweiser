# Copy to .env and adjust. .env is not committed.

# Access control: admin (default) = anyone may use it and propose destinations, admins
# approve and edit; off = no login, everyone may change everything (own PC or a small
# trusted network only; refused together with CLOUDFLARE_TUNNEL_TOKEN).
AUTH_MODE=admin

# Contact (e-mail or URL) appended to the User-Agent of all external requests.
# Required by Transitous, recommended by Nominatim. (Old name: NOMINATIM_CONTACT)
APP_CONTACT=
TIMEZONE=Europe/Berlin

# Host port the web UI is published on (inside the home network only).
APP_PORT=8420

# Path to the SQLite database inside the container.
DATABASE_PATH=/data/wegweiser.sqlite

# Nominatim (public OSM geocoder). Policy: https://operations.osmfoundation.org/policies/nominatim/
# Max. 1 request/s, identifying User-Agent, results are cached locally.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Restrict results to these countries (comma-separated ISO codes, empty = worldwide).
NOMINATIM_COUNTRYCODES=de
# How long geocoding results are cached (days).
GEOCODE_CACHE_DAYS=30

# openrouteservice (HeiGIT) for car/foot routes. Key from https://account.heigit.org
# Only used server-side. Old host api.openrouteservice.org was shut down in Nov 2026.
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice
# Safety margin below the free plan's ~2000 directions requests/day.
ORS_DAILY_LIMIT=1800
ROUTE_CACHE_DAYS=7

# Transitous (public MOTIS 2 API) for public transport. Policy: https://transitous.org/api/
# Non-commercial use only; > 720 /plan requests per day only after coordination.
TRANSITOUS_BASE_URL=https://api.transitous.org
TRANSITOUS_DAILY_LIMIT=300
TRANSIT_CACHE_DAYS=3

# Attribution on page and printout. Leave empty for the public services above.
# Self-hosted MOTIS with NVBW timetables (Datenlizenz Deutschland – Namensnennung 2.0):
#   TRANSIT_ATTRIBUTION=Datensatz der NVBW GmbH
#   TRANSIT_ATTRIBUTION_URL=https://www.nvbw.de/open-data
# Self-hosted openrouteservice (leave ORS_API_KEY empty):
#   ROUTE_ATTRIBUTION=openrouteservice
TRANSIT_ATTRIBUTION=
TRANSIT_ATTRIBUTION_URL=
ROUTE_ATTRIBUTION=

# Map tiles, loaded by the browser. Default: tile.openstreetmap.org (tile usage policy applies).
# TILE_ATTRIBUTION is HTML and must name the tile provider and OpenStreetMap.
TILE_URL=
TILE_ATTRIBUTION=
TILE_MAX_ZOOM=

# Behind a reverse proxy or tunnel (HTTPS): trust its X-Forwarded-* headers, otherwise
# links to CSS/JS are built with http:// and the browser blocks them. "*" is fine when the
# proxy is the only way in from outside; read by uvicorn itself.
FORWARDED_ALLOW_IPS=

# Cloudflare Tunnel (optional, docker compose --profile tunnel): token from the Zero Trust
# dashboard. Only together with a Cloudflare Access policy - Wegweiser has no login.
CLOUDFLARE_TUNNEL_TOKEN=

# Server-side PDFs: address under which the built-in browser reaches the app itself.
# Leave empty in Docker (http://127.0.0.1:8000); for a local uvicorn e.g. http://127.0.0.1:8420
PDF_BASE_URL=
